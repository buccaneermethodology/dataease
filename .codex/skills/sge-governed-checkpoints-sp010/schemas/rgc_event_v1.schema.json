{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rgc_event_v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event_id", "event_type", "observed_at_utc", "source", "control_revision", "record_revision", "payload_sha256"],
  "properties": {
    "schema_version": {"const": "rgc_event_v1"},
    "event_id": {"type": "string", "minLength": 1},
    "event_type": {"enum": ["observation", "control", "progress", "checkpoint", "dispatch_ack", "result", "recovery", "fence"]},
    "observed_at_utc": {"type": "string", "format": "date-time"},
    "source": {"type": "string", "minLength": 1},
    "control_revision": {"type": "integer", "minimum": 0},
    "record_revision": {"type": "integer", "minimum": 0},
    "action_token": {"type": ["string", "null"]},
    "logical_action_id": {"type": ["string", "null"]},
    "fencing_token": {"type": ["string", "null"]},
    "payload_ref": {"type": ["string", "null"]},
    "payload_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}

  "mutation_oracle_matrix": {
    "all_invocations": "recursively freeze each input graph before invocation; after invocation assert the reachable input graph is deeply equal to its pre-call snapshot (for runtime cases, compare supported graph shape without invoking accessors)",
    "success_nonempty_parameters": "assert exact expected result; recursively enumerate mutable output nodes and prove no identity is shared with any input node; for every fixture with a declared mutation path, assign declared replacement, assert output changed, then assert input snapshot unchanged",
    "success_empty_parameters": "assert exact success shape with empty array; identity-isolation check is vacuous; no nested mutation is required",
    "failure": "assert exact {ok:false,reason} shape with no targetComponentId/parameters/partial payload; assert input unchanged; no output mutation is attempted",
    "output_freeze": "not required"
  }
}

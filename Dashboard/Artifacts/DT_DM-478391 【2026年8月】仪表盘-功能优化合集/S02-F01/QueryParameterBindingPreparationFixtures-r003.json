  "input_domain": {
    "root": "unknown at runtime; accepted only if it is a plain record (prototype exactly Object.prototype or null), not null/array/class instance/Date/Map/Set/function",
    "targetComponentId": "own property, non-empty string",
    "sourceParameterIds": "own property, array; every item non-empty string; empty array legal",
    "targetIdBySourceId": "own property, plain record; each own enumerable property value is a non-empty string; exact lookup must use own-property semantics (Object.hasOwn or equivalent); inherited values never satisfy a mapping",
    "targetParameterCatalog": "own property, array; every item plain record with its own non-empty string id",
    "opaque_records": "recursively JSON-safe: null/string/boolean/finite number/array/plain record; reject undefined, bigint, symbol, function, non-finite numbers, accessors, exotic prototypes, and cycles; preserve unknown own enumerable data keys and nested JSON values",
    "catalog_duplicate_policy": "duplicate ids anywhere in supplied catalog fail, including unreferenced entries",
    "mapping_extra_keys": "well-formed extra entries are ignored after all own values pass input-domain validation"
  },
  "failure_precedence": [
    "invalid_input: root/field shape and all supplied source ids, all own mapping values, all catalog record/id shapes and recursively JSON-safe values; fail before mapping resolution",
    "target_parameter_ambiguous: repeated catalog id anywhere, including unreferenced entries",
    "for each unique source id in first-occurrence order: absent own mapping => parameter_mapping_missing; target id absent from catalog => target_parameter_missing; target already assigned to another unique source => target_parameter_collision"
  ],
  "failure_reason_enum": [
    "invalid_input",
    "parameter_mapping_missing",
    "target_parameter_missing",
    "target_parameter_ambiguous",
    "target_parameter_collision"
  ],
  "helper_support_boundary": {
    "same_source_repeated": "collapse to first occurrence, preserving first-occurrence order",
    "different_sources_same_target": "reject locally with target_parameter_collision; not a product-wide policy",
    "duplicate_catalog_id": "reject locally as ambiguous; not a product-wide policy",
    "component_target": "opaque non-empty string; caller proves it belongs to target component",
    "mapping_authority": "caller supplies references extracted from scalar parameters or range endpoint maps, exact source-to-target IDs, and a catalog proven to belong to target component; helper proves none of these"
  },
  "runtime_construction_schema": {
    "schema": "s02_runtime_input_construction_v1",
    "semantics": "runtime_cases are harness instructions, not JSON input values. Build each runtime input exactly from the instruction, call helper once, and assert exact expected shape/reason and unchanged reachable input graph.",
    "ops": [
      "replace_path_with_undefined",
      "replace_path_with_function",
      "replace_path_with_nan",
      "set_prototype",
      "add_cycle",
      "define_accessor",
      "delete_own_property"
    ],
    "mutation_paths": "JSON Pointer-like paths into input, evaluated before freezing; no eval or executable fixture payload"
  },

    {
      "id": "MVP-NEG-006",
      "kind": "pure-contract-test-specification",
      "title": "1–50 叶与 UTF-8 载荷大小正交边界",
      "setup": {
        "serializer": "fixed projection {schemaVersion:1,logic,items} serialized with JSON.stringify and measured with TextEncoder",
        "initial_clipboard": "prior valid envelope",
        "exact_byte_fixture_algorithm": [
          "start from a valid supported payload with fewer than 50 leaves and enumValue[0] equal to the single ASCII character x",
          "serialize the fixed projection and measure baseBytes with TextEncoder",
          "replace enumValue[0] with x followed by exactly (1000000 - baseBytes) ASCII x characters; reserialize and assert measured bytes equal exactly 1000000 before invoking the cap guard",
          "for 1000001 bytes, append one additional ASCII x; keep leaf count below 50 so the byte axis is isolated",
          "for 50/51 leaf tests, use short ASCII values and assert serialized bytes remain below 1000000 so the leaf axis is isolated",
          "for multi-byte coverage, use a non-ASCII enum value and assert TextEncoder byte count, independent of JavaScript string length"
        ]
      },
      "actions": [
        "construct independently valid payloads and assert leaf count and encoded byte length before invoking guard",
        "run copy validation independently for each point"
      ],
      "variants": [
        "50 leaves and <=1000000 bytes: accept",
        "51 leaves and below byte cap: reject",
        "under 50 leaves and exactly 1000000 bytes: accept",
        "under 50 leaves and 1000001 bytes: reject",
        "multibyte enum text: byte count uses UTF-8"
      ],
      "expected": {
        "no_truncation": true,
        "reject_copy_preserves_previous_clipboard": true,
        "accept_boundary_requires_both_predicates": true
      }
    },

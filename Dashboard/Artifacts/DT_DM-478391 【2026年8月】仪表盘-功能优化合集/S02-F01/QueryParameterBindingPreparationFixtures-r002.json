  "input_domain": {
    "top_level": "plain object with targetComponentId non-empty string; sourceParameterIds array; targetIdBySourceId plain object; targetParameterCatalog array",
    "source_ids": "each non-empty string; empty array is valid and returns an empty list",
    "mapping": "every own enumerable value is a non-empty string; mapping keys are exact source IDs; unrelated well-formed keys are ignored",
    "catalog": "each item is a plain object with own non-empty string id; other JSON values are opaque and preserved",
    "opaque_records": "JSON-safe values only (null, string, boolean, finite number, arrays and plain objects); unknown keys retained; no DTO schema or parameter-vs-field classification",
    "catalog_duplicate_policy": "duplicate IDs anywhere in supplied catalog fail, including unreferenced entries"
  },
  "failure_precedence": [
    "invalid_input (validate all top-level fields, all source IDs, every own mapping value, every catalog entry and JSON-safe opaque record)",
    "target_parameter_ambiguous (any repeated catalog id, including unreferenced entries)",
    "for each unique source id in first-occurrence order: parameter_mapping_missing, then target_parameter_missing, then target_parameter_collision"
  ],
  "failure_reason_enum": [
    "invalid_input",
    "parameter_mapping_missing",
    "target_parameter_missing",
    "target_parameter_ambiguous",
    "target_parameter_collision"
  ],
  "helper_support_boundary": {
    "same_source_repeated": "collapse to first occurrence, preserving first-occurrence order",
    "different_sources_same_target": "reject locally with target_parameter_collision; not a product-wide policy",
    "duplicate_catalog_id": "reject locally as ambiguous; not a product-wide policy",
    "component_target": "opaque non-empty string; caller proves it belongs to target component",
    "mapping_authority": "caller supplies references extracted from scalar parameters or range endpoint maps, exact source-to-target IDs, and a catalog proven to belong to target component; helper proves none of these"
  }
}

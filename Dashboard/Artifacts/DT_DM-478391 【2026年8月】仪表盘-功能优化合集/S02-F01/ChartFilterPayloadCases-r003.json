  "contract_ref": "ChartFilterPayloadDesign-r003.md#候选纯函数合同",
  "scope": "detached JSON-shaped chart customFilter copy and source-compatible leaf field handling only",
  "fixture_protocol": {
    "pointer": "Runtime pointers follow RFC 6901. A pointer to a not-yet-existing final own property may be used by define/set operations; all intermediate parents must exist.",
    "runtime_setup": "Execute operations in listed order on a fresh JSON.parse-created fixture. Supported ops: set_special (value_kind from the closed enum in this file), link_reference, define_symbol_key, define_accessor, attach_array_extra_key, define_non_enumerable_key, and define_own_string_key. No eval, imports, or arbitrary source strings.",
    "special_value_kinds": [
      "undefined",
      "function",
      "symbol",
      "bigint",
      "nan",
      "positive_infinity",
      "negative_infinity",
      "sparse_array",
      "date",
      "map",
      "set",
      "class_instance",
      "array_with_group_keys",
      "negative_infinity"
    ],
    "literal_values": "All fixture JSON values are literal business data. Strings/objects named $fixture have no special meaning.",
    "snapshot": "After runtime_setup and before invocation, create a cycle-safe graph snapshot retaining primitives (including NaN semantics), prototypes, own keys/descriptors, array holes, aliases, and reference edges. Equality uses a visited pair table and must terminate on cycles. Do not use JSON.stringify.",
    "mutation_probe": "For each detached assertion, run a fresh setup and invocation, mutate only the selected side at probe_pointer to sentinel, then verify the opposite side equals its pre-mutation graph value.",
    "failure_shape": "Failure result must be an object with exactly keys [ok, reason], ok=false and expected reason; payload must be absent.",
    "accessor_observation": "define_accessor increments case-local getter_call_count if invoked; throwing_getter throws only if invoked. Every accessor case expects getter_call_count=0 after helper returns."
  },

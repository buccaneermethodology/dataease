{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "doc_id",
    "doc_type",
    "title",
    "version",
    "status",
    "output_path",
    "metadata",
    "domains",
    "facts",
    "capabilities",
    "relations"
  ],
  "properties": {
    "doc_id": {
      "type": "string",
      "minLength": 1
    },
    "doc_type": {
      "const": "static_knowledge"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "const": "static_verified"
    },
    "output_path": {
      "type": "string",
      "minLength": 1
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner",
        "updated_at",
        "source_repo",
        "source_revision",
        "source_scope",
        "depends_on_docs"
      ],
      "properties": {
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "updated_at": {
          "type": "string",
          "minLength": 1
        },
        "source_repo": {
          "type": "string",
          "minLength": 1
        },
        "source_revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "source_scope": {
          "type": "string",
          "minLength": 1
        },
        "depends_on_docs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        }
      }
    },
    "domains": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^K(0[0-9]|1[01])$"
      },
      "minItems": 1
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "statement",
          "kind",
          "scope",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "implemented",
              "configured",
              "normative"
            ]
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "start_line",
                "end_line",
                "symbol",
                "sha256"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "start_line": {
                  "type": "integer",
                  "minimum": 1
                },
                "end_line": {
                  "type": "integer",
                  "minimum": 1
                },
                "symbol": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            },
            "minItems": 1
          }
        }
      },
      "minItems": 1
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "depth",
          "summary",
          "contract",
          "limits"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "depth": {
            "enum": [
              "core",
              "navigation"
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "contract": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "trigger",
              "inputs",
              "outputs",
              "preconditions",
              "state_changes",
              "postconditions",
              "invariants",
              "failures",
              "permissions",
              "implementation",
              "dependencies",
              "data",
              "tests"
            ],
            "properties": {
              "trigger": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 0
              },
              "inputs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 0
              },
              "outputs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 0
              },
              "preconditions": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 0
              },
              "state_changes": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 0
              },
              "postconditions": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 0
              },
              "invariants": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 0
              },
              "failures": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 0
              },
              "permissions": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 0
              },
              "implementation": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 0
              },
              "dependencies": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 0
              },
              "data": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 0
              },
              "tests": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 0
              }
            }
          },
          "limits": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          }
        }
      },
      "minItems": 0
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "type",
          "from",
          "to",
          "evidence_fact_ids"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "enum": [
              "PRODUCT_HAS_CAPABILITY",
              "CAPABILITY_REALIZED_BY",
              "MODULE_DEPENDS_ON",
              "API_EXPOSES_CAPABILITY",
              "UI_CALLS_API",
              "CAPABILITY_READS_WRITES_DATA",
              "IMPLEMENTATION_COVERED_BY_TEST",
              "FACT_SUPPORTED_BY_EVIDENCE",
              "CHANGE_IMPACTS",
              "GAP_BLOCKS_CLAIM",
              "DEPENDS_ON",
              "CALLS",
              "TEST_ASSET_FOR"
            ]
          },
          "from": {
            "type": "string",
            "minLength": 1
          },
          "to": {
            "type": "string",
            "minLength": 1
          },
          "evidence_fact_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          }
        }
      },
      "minItems": 0
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dataease-kb-document-v1"
}

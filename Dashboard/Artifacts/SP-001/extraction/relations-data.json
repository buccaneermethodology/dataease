      "basis": "previewData入口调用previewDataWithLimit，权限开关仍依入口区分"
    },
    {
      "relation_id": "DATA-X014",
      "basis": "previewDataWithLimit显式按crossDs调用ProviderFactory"
    },
    {
      "relation_id": "DATA-X015",
      "basis": "CalciteProvider非跨源分支直接委派jdbcFetchResultField"
    },
    {
      "relation_id": "DATA-X016",
      "basis": "建表/删表调用ProviderUtil.getEngineProvider"
    },
    {
      "relation_id": "DATA-X017",
      "basis": "DB字段获取前调用DatasetCacheManage.validateTable"
    },
    {
      "relation_id": "DATA-X018",
      "basis": "表/字段缓存写入调用CacheUtils.put"
    },
    {
      "relation_id": "DATA-X019",
      "basis": "数据源能力经innerSave和repository保存CoreDatasource"
    },
    {
      "relation_id": "DATA-X020",
      "basis": "数据集保存维护分组、表与字段元数据"
    }

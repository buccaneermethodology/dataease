{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dataease_requirement_baseline_v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "doc_id", "title", "version", "status", "implementation_status", "metadata", "authority", "scope", "features", "cross_cutting_context", "provenance", "change_log"],
  "properties": {
    "schema_version": {"const": "dataease_requirement_baseline_v1"},
    "doc_id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "status": {"const": "approved_requirement_baseline"},
    "implementation_status": {"const": "not_assessed"},
    "metadata": {
      "type": "object",
      "required": ["owner", "updated_at", "source_scope", "source_precedence", "depends_on_docs", "change_policy"],
      "properties": {
        "owner": {"type": "string", "minLength": 1},
        "updated_at": {"type": "string", "format": "date"},
        "source_scope": {"type": "string", "minLength": 1},
        "source_precedence": {"type": "array", "minItems": 2, "items": {"type": "string"}},
        "depends_on_docs": {"type": "array", "items": {"type": "string"}},
        "change_policy": {"type": "string", "minLength": 1}
      }
    },
    "authority": {
      "type": "object",
      "required": ["primary_source", "primary_source_role", "reference_sources", "conflict_rule"],
      "properties": {
        "primary_source": {"type": "string", "minLength": 1},
        "primary_source_role": {"const": "authoritative_latest_decisions"},
        "reference_sources": {"type": "array", "items": {"type": "object", "required": ["path", "role", "sha256"], "properties": {"path": {"type": "string"}, "role": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "note": {"type": "string"}}}},
        "conflict_rule": {"type": "string", "minLength": 1}
      }
    },
    "scope": {"type": "object", "required": ["features_in_scope", "confirmed_decision_ids", "excluded_or_unresolved", "global_decision_ids", "decision_id_coverage", "decision_ids_missing_from_feature_bullets"], "properties": {"features_in_scope": {"type": "array", "minItems": 8, "items": {"type": "string"}}, "confirmed_decision_ids": {"type": "string"}, "excluded_or_unresolved": {"type": "array", "items": {"type": "string"}}, "global_decision_ids": {"type": "array", "items": {"type": "integer"}}, "decision_id_coverage": {"type": "array", "items": {"type": "integer"}}, "decision_ids_missing_from_feature_bullets": {"type": "array", "items": {"type": "integer"}}}},
    "features": {"type": "array", "minItems": 8, "maxItems": 8, "items": {"type": "object", "required": ["id", "title", "tsp", "decisions", "acceptance", "open_items", "workflow"], "properties": {"id": {"type": "string", "pattern": "^F0[1-8]$"}, "title": {"type": "string"}, "tsp": {"type": "string"}, "decisions": {"type": "array", "items": {"type": "object", "required": ["ids", "text"], "properties": {"ids": {"type": "array", "items": {"type": "integer"}}, "text": {"type": "string"}}}}, "acceptance": {"type": "array", "items": {"type": "string"}}, "open_items": {"type": "array", "items": {"type": "string"}}, "workflow": {"type": "string"}}}},
    "cross_cutting_context": {"type": "object", "required": ["source_section_0", "source_section_9", "source_section_10", "source_section_11"], "properties": {"source_section_0": {"type": "string"}, "source_section_9": {"type": "string"}, "source_section_10": {"type": "string"}, "source_section_11": {"type": "string"}}},
    "provenance": {"type": "object", "required": ["repository_head_at_capture", "primary_source_sha256", "source_captured_at", "source_line_count", "decision_range_note"], "properties": {"repository_head_at_capture": {"type": "string", "pattern": "^[a-f0-9]{40}$"}, "primary_source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "source_captured_at": {"type": "string", "format": "date"}, "source_line_count": {"type": "integer", "minimum": 1}, "decision_range_note": {"type": "string"}}},
    "change_log": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["version", "date", "change", "supersedes"], "properties": {"version": {"type": "string"}, "date": {"type": "string", "format": "date"}, "change": {"type": "string"}, "supersedes": {"type": ["string", "null"]}}}}
  }
}
